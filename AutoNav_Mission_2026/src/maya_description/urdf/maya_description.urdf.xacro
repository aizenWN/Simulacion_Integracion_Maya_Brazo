<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- brief Top level robot description for Maya Rover -->
  <!-- This file aggregates shared properties, physical model and Gazebo plugins -->

  <xacro:include filename="$(find maya_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find maya_description)/urdf/mobile_base.xacro"/>
  <xacro:include filename="$(find maya_description)/urdf/mobile_base_gazebo.xacro"/>
  <xacro:include filename="$(find maya_description)/urdf/sensors.xacro"/>


</robot>
