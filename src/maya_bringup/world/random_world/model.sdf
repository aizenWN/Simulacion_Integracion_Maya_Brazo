<?xml version="1.0"?>
<sdf version="1.10">
  <model name="random_world">
    <static>true</static>

    <link name="link">
      <!-- Collision heightmap -->
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://random_world/media/materials/texture/random_world.png</uri>
            <size>40 40 1</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>

      <!-- Visual heightmap (single texture + normal) -->
      <visual name="visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://random_world/media/materials/texture/Mars-diffuse.png</diffuse>
              <normal>model://random_world/media/materials/texture/Mars-normal.png</normal>
              <size>3</size>
            </texture>
            <uri>model://random_world/media/materials/texture/random_world.png</uri>
            <size>40 40 1</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
